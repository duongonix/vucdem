{
	"name": "vucdem",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check \"src/**/*.{ts,svelte,css,html}\" \"*.{js,ts,json}\" && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:rules": "vitest run src/lib/server/firestore-rules.integration.spec.ts",
		"test:emulator": "firebase emulators:exec --only firestore --project demo-vucdem \"pnpm test:rules\"",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "npm run build && start-server-and-test \"npm run preview -- --host 127.0.0.1\" http://127.0.0.1:4173 \"playwright test\"",
		"test:e2e:install": "playwright install chromium",
		"verify:production-services": "node scripts/verify-production-services.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^5.0.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"firebase-tools": "^15.28.2",
		"globals": "^17.11.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"start-server-and-test": "^3.0.12",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@lucide/svelte": "^1.34.0",
		"bits-ui": "^2.19.0",
		"cloudinary": "^2.10.1",
		"clsx": "^2.1.1",
		"firebase": "^12.18.0",
		"firebase-admin": "^14.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.4.3"
	}
}
