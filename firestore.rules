rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All application persistence currently goes through authenticated SvelteKit
    // server endpoints backed by Firebase Admin. The browser SDK is used only to
    // allocate document IDs, so direct client reads/writes are intentionally denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
