# Firebase values are safe to expose to the browser. They identify the Firebase project;
# authorization is enforced by Firebase Authentication and Firestore Security Rules.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional local development emulators. Connections are enabled only in dev when true.
PUBLIC_FIREBASE_USE_EMULATORS=false
PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Server-only Firebase Admin credentials. Prefer Application Default Credentials on
# supported hosts; set these three values together when a service account is needed.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloudinary cloud name is browser-safe and is used to build delivery/upload URLs.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only Cloudinary credentials. Never rename these with a PUBLIC_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
